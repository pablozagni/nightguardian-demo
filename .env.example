APP_NAME="NightGuardian Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite works for everything except the "slow query" button, which needs MySQL/MariaDB (SELECT SLEEP).
# For that one: DB_CONNECTION=mysql, DB_DATABASE=nightguardian_demo, DB_USERNAME, DB_PASSWORD.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- NightGuardian: where the errors of this demo go ------------------------------------------------------------
NIGHTGUARDIAN_URL=
NIGHTGUARDIAN_TOKEN=
NIGHTGUARDIAN_ENVIRONMENT=demo
# NIGHTGUARDIAN_LOG_LEVEL=error        # "warning" to also send Log::warning()
# NIGHTGUARDIAN_SLOW_REQUEST_MS=2000
# NIGHTGUARDIAN_SLOW_QUERY_MS=1000

# --- Site and live demo ----------------------------------------------------------------------------------------
# NIGHTGUARDIAN_SITE_URL=https://nightguardian.com.ar
# NIGHTGUARDIAN_PANEL_URL=https://demo.nightguardian.com.ar
# NIGHTGUARDIAN_DEMO_VISITOR_EMAIL=visitor@demo.example.com
# NIGHTGUARDIAN_DEMO_VISITOR_PASSWORD=visitor-demo
# DEMO_TRY_RATE_LIMIT=20        # actions per minute per IP on /try
# DEMO_BURST_MAX=20
# If set, /try asks for this key first (a private demo).
DEMO_KEY=

# "Support the project": a button only appears when its URL is set.
NIGHTGUARDIAN_SPONSOR_GITHUB_URL=
NIGHTGUARDIAN_DONATE_MP_URL=
